# E-ink PDF Templates — Environment Configuration
#
# Copy this file to `.env` and update values for your deployment.
# Variables fall into four groups:
#   1. Backend (Pydantic Settings) — read by backend/app/config.py.
#      Variable names are the literal Settings field names (case-sensitive,
#      no prefix).
#   2. Backend (legacy) — read directly via os.getenv in modules that haven't
#      moved to Settings yet (mostly EINK_* names).
#   3. Frontend — Vite build-time variables (must be prefixed VITE_).
#   4. Docker Compose — variables only referenced by `${...}` substitution
#      in docker-compose.yml.
#
# Required variables for production are marked [REQUIRED]. Without them, the
# backend either refuses to start (DEBUG=False + missing JWT secret) or runs
# with insecure defaults.

# ============================================================================
# 1. Backend — Pydantic Settings (canonical names)
# ============================================================================

# Set to True only in development. When False, the backend asserts that a real
# JWT secret is configured and disables /docs and /redoc.
DEBUG=False

# [REQUIRED in prod outside docker compose] One of these two must be set.
# Under docker compose, the entrypoint generates JWT_SECRET_KEY_FILE on first
# run when JWT_SECRET_KEY is empty.
#   JWT_SECRET_KEY      — the secret value itself
#   JWT_SECRET_KEY_FILE — path to a file containing the secret on its own line
# If both are set, JWT_SECRET_KEY wins. Generate a strong value:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET_KEY=replace-with-strong-random-string
# JWT_SECRET_KEY_FILE=/app/backend/data/users/jwt_secret.txt

# Token TTL in minutes (default 90).
# ACCESS_TOKEN_EXPIRE_MINUTES=90

# Allowed CORS origins (defaults cover localhost dev + the production domain).
# Override only if you serve from a different domain.
# CORS_ORIGINS=["https://example.com"]

# Database (default points at backend/data/einkpdf.sqlite).
# DATABASE_URL=sqlite:///data/einkpdf.sqlite

# Rate limits (slowapi format: "<count>/<unit>"). Defaults shown.
# RATE_LIMIT_ENABLED=True
# LOGIN_RATE_LIMIT=10/minute
# REGISTER_RATE_LIMIT=5/minute
# PASSWORD_RESET_REQUEST_RATE_LIMIT=3/minute
# PASSWORD_RESET_CONFIRM_RATE_LIMIT=10/minute
# PDF_GENERATE_RATE_LIMIT=10/minute
# PROJECT_CREATE_RATE_LIMIT=30/minute

# WebSocket preview caps. The endpoint is intentionally unauthenticated; these
# bounds are the abuse mitigation.
# WS_MAX_YAML_BYTES=262144           # 256 KB per submission
# WS_PREVIEW_REQUESTS_PER_MINUTE=30  # per open connection
# WS_MAX_CONNECTIONS_PER_IP=10
# WS_PREVIEW_TIMEOUT_SECONDS=30

# ============================================================================
# 2. Backend — legacy (os.getenv-style EINK_* variables)
#
# These are read directly by older modules (workspaces.py, auth.py legacy
# JWTService, EmailService, einkpdf core profile loader). Some are still
# load-bearing in production:
# ============================================================================

# Base data directory inside the container/host (mounted to a persistent volume).
EINK_DATA_DIR=./backend/data

# Profile YAML directory (read by einkpdf core).
EINK_PROFILE_DIR=./config/profiles

# Templates cleanup TTL (days). 0 disables cleanup.
EINK_CLEANUP_TTL_DAYS=14

# Path to the on-disk JWT secret file used by the legacy auth.py. The active
# Pydantic Settings code also reads this name as a fallback when neither
# JWT_SECRET_KEY nor JWT_SECRET_KEY_FILE is set, so existing prod deployments
# work without changing the variable name.
# EINK_JWT_SECRET_FILE=/app/backend/data/users/jwt_secret.txt

# Password reset link sent in emails.
EINK_PASSWORD_RESET_URL=http://localhost:5173/reset-password
EINK_PASSWORD_RESET_TTL_MINUTES=60

# Email — file-based by default; set the SMTP_* vars to send for real.
EINK_EMAIL_OUTPUT_DIR=./backend/data/emails
# EINK_SMTP_HOST=smtp.gmail.com
# EINK_SMTP_PORT=587
# EINK_SMTP_USERNAME=your-email@example.com
# EINK_SMTP_PASSWORD=your-smtp-password-or-app-password
# EINK_SMTP_FROM=noreply@example.com
# EINK_SMTP_USE_TLS=true

# ============================================================================
# 3. Frontend — Vite build-time variables
# ============================================================================

# API base URL the React app talks to. Use a relative path when the frontend
# is served same-origin behind a reverse proxy.
VITE_API_BASE_URL=/api

# ============================================================================
# 4. Docker Compose substitution variables (referenced as ${...} in compose)
# ============================================================================

# Host port the frontend container is published on.
FRONTEND_PORT=3000

# Host directory bind-mounted as the backend data volume (DB, assets, JWT secret).
# DATA_DIR=./data

# Host directory with device profile YAMLs (mounted read-only).
# PROFILE_DIR=./config/profiles

# SMTP credentials passed into the backend container via the compose env list
# (substituted into EINK_SMTP_USERNAME / EINK_SMTP_PASSWORD).
# EMAIL_FROM=noreply@example.com
# EMAIL_PASSWORD=your-smtp-password-or-app-password

# Override the password-reset URL substituted into compose.
# PASSWORD_RESET_URL=https://example.com/reset-password
